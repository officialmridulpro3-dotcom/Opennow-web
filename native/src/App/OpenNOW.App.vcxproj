<?xml version="1.0" encoding="utf-8"?>
<!-- OpenNOW — WinUI 3 (Windows App SDK) C++/WinRT application.

     Unpackaged by default (WindowsPackageType=None): the installer story is a
     plain folder + optional MSIX, and it keeps the DirectX swap chain out of
     the UWP container's restrictions. Set EnableMsixTooling=true and add a
     Package.appxmanifest if you want a packaged build; nothing else changes. -->
<Project ToolsVersion="16.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- ApplicationType=Windows Store is what loads the XAML compiler, but it
       also makes NuGet infer a "UAP,Version=v10.0" framework, which then
       refuses to restore. This is a native project: say so explicitly. -->
  <PropertyGroup Label="NuGet">
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <NuGetTargetMoniker>native,Version=v0.0</NuGetTargetMoniker>
    <NuGetTargetPlatformIdentifier>Windows</NuGetTargetPlatformIdentifier>
    <NuGetTargetPlatformVersion>$(WindowsTargetPlatformVersion)</NuGetTargetPlatformVersion>
    <!-- NuGet needs the platform's RID listed once the project is a Windows
         Store project. -->
    <RuntimeIdentifiers>win10-x86;win10-x64;win10-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6F2A1B7C-4B31-4C9E-9A64-0E1B2C3D4E5F}</ProjectGuid>
    <RootNamespace>OpenNOW</RootNamespace>
    <WindowsAppContainer>false</WindowsAppContainer>
    <AppContainerApplication>false</AppContainerApplication>
    <!-- Loads the XAML compiler targets. Without it nothing compiles the
         markup: no .xbf is produced and no page gets an InitializeComponent. -->
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <TargetPlatformVersion>10.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <CppWinRTGenerateWindowsMetadata>true</CppWinRTGenerateWindowsMetadata>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- Windows App SDK + WIL. Bump these in lockstep with Directory.Build.props. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="2.0.240405.15" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.ImplementationLibrary" Version="1.0.240803.1" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /utf-8</AdditionalOptions>
      <AdditionalIncludeDirectories>
        $(MSBuildProjectDirectory)\..;
        $(MSBuildProjectDirectory)\..\Core\include;
        $(MSBuildProjectDirectory)\..\DirectX\include;
        $(IntDir);
        $(IntDir)Generated Files\;
        $(IntDir)Generated Files\Views\;
        $(IntDir)Generated Files\Controls\;
        $(IntDir)Views\;
        $(IntDir)Controls\;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Generated sources (XamlTypeInfo.Impl.g.cpp and friends) are added by
           the XAML compiler and have no #include of their own, so force pch.h
           into every translation unit rather than relying on /Yu. -->
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ForcedIncludeFiles>$(MSBuildProjectDirectory)\pch.h</ForcedIncludeFiles>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>
        d3d10_1.lib;d3d11.lib;dxgi.lib;d3dcompiler.lib;windowsapp.lib;crypt32.lib;winhttp.lib;%(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- ── precompiled header ──────────────────────────────────────────────── -->
  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>

  <!-- ── IDL: every WinRT type must be declared here ──────────────────────── -->
  <ItemGroup>
    <Midl Include="App.idl" />
    <Midl Include="MainWindow.idl" />
    <Midl Include="Controls\StreamSurfacePanel.idl" />
    <Midl Include="Views\HomePage.idl" />
    <Midl Include="Views\LibraryPage.idl" />
    <Midl Include="Views\LoginPage.idl" />
    <Midl Include="Views\GameDetailsPage.idl" />
    <Midl Include="Views\PlaytimePage.idl" />
    <Midl Include="Views\SettingsPage.idl" />
    <Midl Include="Views\StreamPage.idl" />
  </ItemGroup>

  <!-- ── sources ─────────────────────────────────────────────────────────── -->
  <!-- DependentUpon is what tells the XAML compiler which .cpp is the
       code-behind for a .xaml file; without it no InitializeComponent is
       generated. -->
  <ItemGroup>
    <ClCompile Include="App.cpp">
      <DependentUpon>App.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="MainWindow.cpp">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="Controls\StreamSurfacePanel.cpp" />
    <ClCompile Include="Services\AppServices.cpp" />
    <ClCompile Include="Views\HomePage.cpp">
      <DependentUpon>HomePage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="Views\LibraryPage.cpp">
      <DependentUpon>LibraryPage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="Views\LoginPage.cpp">
      <DependentUpon>LoginPage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="Views\GameDetailsPage.cpp">
      <DependentUpon>GameDetailsPage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="Views\PlaytimePage.cpp">
      <DependentUpon>PlaytimePage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="Views\SettingsPage.cpp">
      <DependentUpon>SettingsPage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="Views\StreamPage.cpp">
      <DependentUpon>StreamPage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="..\DirectX\src\StreamSurface.cpp">
      <!-- Lives in the DirectX tree and is also built by that project: it
           includes its own headers, not this project's precompiled header. -->
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <!-- cppwinrt's activation-factory glue for the authored WinRT types. -->
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="App.h">
      <DependentUpon>App.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="MainWindow.h">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="Controls\StreamSurfacePanel.h" />
    <ClInclude Include="Services\AppServices.h" />
    <ClInclude Include="Views\HomePage.h">
      <DependentUpon>HomePage.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="Views\LibraryPage.h">
      <DependentUpon>LibraryPage.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="Views\LoginPage.h">
      <DependentUpon>LoginPage.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="Views\GameDetailsPage.h">
      <DependentUpon>GameDetailsPage.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="Views\PlaytimePage.h">
      <DependentUpon>PlaytimePage.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="Views\SettingsPage.h">
      <DependentUpon>SettingsPage.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="Views\StreamPage.h">
      <DependentUpon>StreamPage.xaml</DependentUpon>
    </ClInclude>
  </ItemGroup>

  <!-- ── XAML ────────────────────────────────────────────────────────────── -->
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainWindow.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\HomePage.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\LibraryPage.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\LoginPage.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\GameDetailsPage.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\PlaytimePage.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\SettingsPage.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\StreamPage.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- ── resources ───────────────────────────────────────────────────────── -->
  <ItemGroup>
    <Resource Include="Themes\GeneratedTokens.xaml" />
    <Resource Include="Themes\Styles.xaml" />
    <Resource Include="Themes\Accents.xaml" />
    <Image Include="..\..\..\public\opennow-logo.png">
      <Link>Assets\opennow-logo.png</Link>
    </Image>
    <Image Include="..\..\..\public\opennow-logo-mark.png">
      <Link>Assets\opennow-logo-mark.png</Link>
    </Image>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>

  <!-- ── project references ──────────────────────────────────────────────── -->
  <ItemGroup>
    <ProjectReference Include="..\Core\OpenNOW.Core.vcxproj" />
  </ItemGroup>

  <!-- cppwinrt writes the generated header for Views\HomePage.idl into
       "Generated Files\Views\HomePage.g.h", mirroring the source tree. Copy
       every generated header next to the flat ones so a page can simply
       #include "HomePage.g.h" wherever it lives. -->
  <Target Name="OpenNOWFlattenGeneratedHeaders" BeforeTargets="ClCompile">
    <ItemGroup>
      <OpenNOWGeneratedHeader Include="$(IntDir)**\*.g.h" />
      <OpenNOWGeneratedHeader Include="$(IntDir)**\*.g.hpp" />
      <OpenNOWGeneratedHeader Include="$(MSBuildProjectDirectory)\**\*.g.h" />
    </ItemGroup>
    <Copy SourceFiles="@(OpenNOWGeneratedHeader)"
          DestinationFolder="$(IntDir)Generated Files\"
          SkipUnchangedFiles="true" />
  </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
