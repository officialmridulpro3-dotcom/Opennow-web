<Page
    x:Class="OpenNOW.Views.GameDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ProgressRing x:Name="LoadingRing"
                      Width="28"
                      Height="28"
                      IsActive="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

        <ScrollViewer x:Name="DetailsScroller" Visibility="Collapsed">
            <StackPanel Spacing="0">

                <!-- Hero -->
                <Grid Height="380">
                    <Image x:Name="HeroImage" Stretch="UniformToFill" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#33070B12" Offset="0" />
                                <GradientStop Color="#070B12" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Button x:Name="BackButton"
                            Style="{StaticResource OpenNowGhostButton}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Margin="24,16,0,0"
                            Click="OnBack">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>

                    <StackPanel VerticalAlignment="Bottom"
                                Margin="36,0,36,28"
                                Spacing="14">
                        <TextBlock x:Name="TitleText"
                                   FontSize="36"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource OpenNowInkBrush}" />
                        <StackPanel x:Name="MetaRow" Orientation="Horizontal" Spacing="10" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="PlayButton"
                                    Style="{StaticResource OpenNowPrimaryButton}"
                                    Click="OnPlay">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RegionButton"
                                    Style="{StaticResource OpenNowSecondaryButton}"
                                    Click="OnPickRegion">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="12" />
                                    <TextBlock x:Name="RegionButtonText" Text="Closest region" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Body -->
                <Grid Padding="36,28" ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="16">
                        <TextBlock Text="About"
                                   Style="{StaticResource OpenNowShelfTitle}" />
                        <TextBlock x:Name="DescriptionText"
                                   Style="{StaticResource OpenNowBodySoftText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Facts panel -->
                    <Border Grid.Column="1"
                            Style="{StaticResource OpenNowSectionCard}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Details" Style="{StaticResource OpenNowShelfTitle}" />
                            <Grid Style="{StaticResource OpenNowSettingsRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Store" Style="{StaticResource OpenNowSettingsHint}" />
                                <TextBlock Grid.Column="1" x:Name="StoreText"
                                           Style="{StaticResource OpenNowBodyText}" />
                            </Grid>
                            <Grid Style="{StaticResource OpenNowSettingsRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Publisher" Style="{StaticResource OpenNowSettingsHint}" />
                                <TextBlock Grid.Column="1" x:Name="PublisherText"
                                           Style="{StaticResource OpenNowBodyText}" />
                            </Grid>
                            <Grid Style="{StaticResource OpenNowSettingsRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Developer" Style="{StaticResource OpenNowSettingsHint}" />
                                <TextBlock Grid.Column="1" x:Name="DeveloperText"
                                           Style="{StaticResource OpenNowBodyText}" />
                            </Grid>
                            <Grid Style="{StaticResource OpenNowSettingsRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Genres" Style="{StaticResource OpenNowSettingsHint}" />
                                <TextBlock Grid.Column="1" x:Name="GenresText"
                                           Style="{StaticResource OpenNowBodyText}"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Controllers" Style="{StaticResource OpenNowSettingsHint}" />
                                <TextBlock Grid.Column="1" x:Name="ControllerText"
                                           Style="{StaticResource OpenNowBodyText}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Region picker flyout -->
        <Grid x:Name="RegionOverlay"
              Background="#CC070B12"
              Visibility="Collapsed">
            <Border Width="420"
                    Padding="24"
                    CornerRadius="{StaticResource rXl}"
                    Background="{ThemeResource OpenNowPanelBrush}"
                    BorderBrush="{ThemeResource OpenNowPanelBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Choose a region"
                               Style="{StaticResource OpenNowShelfTitle}" />
                    <TextBlock Text="Latency is measured with a bounded HTTPS check against each data centre."
                               Style="{StaticResource OpenNowSettingsHint}" />
                    <ProgressRing x:Name="RegionLoading" Width="20" Height="20" IsActive="True" />
                    <ListView x:Name="RegionList"
                              Height="300"
                              SelectionMode="Single"
                              SelectionChanged="OnRegionSelected" />
                    <Button Content="Cancel"
                            Style="{StaticResource OpenNowSecondaryButton}"
                            HorizontalAlignment="Right"
                            Click="OnCancelRegion" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
