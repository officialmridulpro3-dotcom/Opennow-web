<Page
    x:Class="OpenNOW.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="SortBox"
                          Width="160"
                          SelectedIndex="0"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Recently played" />
                    <ComboBoxItem Content="A → Z" />
                    <ComboBoxItem Content="Most played" />
                </ComboBox>
                <ToggleButton x:Name="OwnedToggle"
                              Content="Owned only"
                              IsChecked="True"
                              Click="OnFilterChanged" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       x:Name="ResultCount"
                       Style="{StaticResource OpenNowHeaderMeta}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Grid / list host. The GridView is virtualised, so a 1000-game
             library scrolls without building 1000 cards. -->
        <Grid Grid.Row="1">
            <ProgressRing x:Name="LoadingRing"
                          Width="28"
                          Height="28"
                          IsActive="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />

            <GridView x:Name="GameGrid"
                      Visibility="Collapsed"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnGameClicked"
                      ContainerContentChanging="OnContainerChanging">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="180" Height="270" CornerRadius="{StaticResource rLg}">
                            <Image Stretch="UniformToFill" Source="{Binding PosterUrl}" />
                            <Border VerticalAlignment="Bottom" Padding="10" Background="#B3070B12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource OpenNowInkBrush}" />
                                    <TextBlock Text="{Binding PlatformLabel}"
                                               Style="{StaticResource OpenNowCaptionText}" />
                                </StackPanel>
                            </Border>
                            <!-- Owned badge, matching the library filter. -->
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Padding="8,3"
                                    CornerRadius="{StaticResource rPill}"
                                    Background="{ThemeResource OpenNowAccentBrush}"
                                    Visibility="{Binding Owned}">
                                <TextBlock Text="Owned"
                                           FontSize="10"
                                           Foreground="{StaticResource accentOnColor}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock x:Name="EmptyText"
                       Text="No games match this filter."
                       Style="{StaticResource OpenNowBodySoftText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
