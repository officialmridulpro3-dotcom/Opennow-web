# Public origin used for WebSocket origin checks in production.
OPENNOW_ORIGIN=https://opennow.example.com
# At least 32 random characters. All server instances must use the same value.
SESSION_SECRET=replace-with-a-long-random-production-secret
PORT=3000
# Optional, development only. Comma-separated Host header values Vite's dev server
# should accept when you browse through a tunnel, cloud IDE, or reverse proxy.
# Example: OPENNOW_DEV_ALLOWED_HOSTS=.example.test,localhost
OPENNOW_DEV_ALLOWED_HOSTS=

# Native (NVST) streamer, desktop app only. The shell sets this automatically
# when it spawns the sidecar: Ctrl+G / Ctrl+N / Guide are routed to the styled
# web overlay instead of the engine's built-in GDI stream menu.
# OPENNOW_NATIVE_HOST_OVERLAY=1
