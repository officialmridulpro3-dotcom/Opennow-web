{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenNOW",
  "version": "0.1.0",
  "identifier": "app.opennow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build && npm run desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "resources/server.mjs": "server.mjs",
      "../dist": "dist"
    },
    "externalBin": ["binaries/opennow-server", "binaries/opennow-nvst"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
